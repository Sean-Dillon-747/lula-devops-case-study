# Orders service: identity -> Key Vault -> Postgres -> app + migration job.
#
# Secrets story in one paragraph:
#   The DB password is generated by an EPHEMERAL resource and handed only to
#   write-only arguments (administrator_password_wo, value_wo). Terraform sends it to
#   Azure but never writes it to the plan or the state file. The app never sees a
#   secret in config either: its managed identity is granted "Key Vault Secrets User",
#   and Container Apps resolves the Key Vault reference at runtime.
#   Rotation = bump db_password_version and apply; both the server and the vault get
#   the new value in the same apply, and new revisions pick it up (versionless ID).

data "azurerm_client_config" "current" {}

resource "random_string" "suffix" {
  length  = 5
  upper   = false
  special = false
}

locals {
  base           = "${var.name}-${var.environment}"
  suffix         = random_string.suffix.result
  db_admin_login = "${var.name}_admin"
  db_name        = "app"
  db_secret_name = "db-url"
}

# ---- Identity ------------------------------------------------------------------
# User-assigned (not system-assigned) so its role assignments exist BEFORE the app is
# created: no first-boot race where the app starts without Key Vault access.
resource "azurerm_user_assigned_identity" "app" {
  name                = "id-${local.base}"
  resource_group_name = var.resource_group_name
  location            = var.location
  tags                = var.tags
}

resource "azurerm_role_assignment" "app_acr_pull" {
  scope                = var.acr_id
  role_definition_name = "AcrPull"
  principal_id         = azurerm_user_assigned_identity.app.principal_id
  principal_type       = "ServicePrincipal"
}

# ---- Key Vault -----------------------------------------------------------------
resource "azurerm_key_vault" "main" {
  name                       = "kv-${local.base}-${local.suffix}"
  resource_group_name        = var.resource_group_name
  location                   = var.location
  tenant_id                  = data.azurerm_client_config.current.tenant_id
  sku_name                   = "standard"
  rbac_authorization_enabled = true # Azure RBAC, not legacy access policies
  purge_protection_enabled   = true
  soft_delete_retention_days = 90
  # Sketch shortcut: in prod this is false + a private endpoint, and the pipeline
  # runs on agents inside the VNet.
  public_network_access_enabled = true
  tags                          = var.tags
}

# Least privilege, split by job: the app can only READ secrets; the deploying
# principal can write them. Nobody gets "Key Vault Administrator".
resource "azurerm_role_assignment" "app_kv_secrets_user" {
  scope                = azurerm_key_vault.main.id
  role_definition_name = "Key Vault Secrets User"
  principal_id         = azurerm_user_assigned_identity.app.principal_id
  principal_type       = "ServicePrincipal"
}

resource "azurerm_role_assignment" "deployer_kv_secrets_officer" {
  scope                = azurerm_key_vault.main.id
  role_definition_name = "Key Vault Secrets Officer"
  principal_id         = data.azurerm_client_config.current.object_id
}

# ---- PostgreSQL ----------------------------------------------------------------
ephemeral "random_password" "db" {
  length      = 40
  special     = false # it goes into a URL; 40 alphanumerics is ~238 bits of entropy
  min_upper   = 2
  min_lower   = 2
  min_numeric = 2
}

resource "azurerm_postgresql_flexible_server" "main" {
  name                = "psql-${local.base}-${local.suffix}"
  resource_group_name = var.resource_group_name
  location            = var.location
  version             = var.postgres_version
  sku_name            = var.db_sku_name
  storage_mb          = 32768
  auto_grow_enabled   = true

  administrator_login               = local.db_admin_login
  administrator_password_wo         = ephemeral.random_password.db.result
  administrator_password_wo_version = var.db_password_version

  authentication {
    password_auth_enabled = true
    # Next step: Entra auth for the app's managed identity, then password auth off,
    # so there is no DB password left to leak at all.
    active_directory_auth_enabled = true
    tenant_id                     = data.azurerm_client_config.current.tenant_id
  }

  backup_retention_days = 7 # PITR window; prod 35. Backups are the last resort, not the migration plan.
  # Sketch shortcut: prod uses delegated_subnet_id + private_dns_zone_id (VNet only).
  public_network_access_enabled = true

  tags = var.tags

  lifecycle {
    prevent_destroy = true   # a typo in a PR must not be able to delete the database
    ignore_changes  = [zone] # Azure picks/moves the zone (e.g. on HA failover); don't fight it
  }
}

# Sketch shortcut (0.0.0.0 = "Azure services"); replaced by VNet integration in prod.
resource "azurerm_postgresql_flexible_server_firewall_rule" "azure_services" {
  name             = "AllowAzureServices"
  server_id        = azurerm_postgresql_flexible_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}

resource "azurerm_postgresql_flexible_server_database" "app" {
  name      = local.db_name
  server_id = azurerm_postgresql_flexible_server.main.id
  charset   = "UTF8"
  collation = "en_US.utf8"

  lifecycle {
    prevent_destroy = true
  }
}

# The connection string is built from the ephemeral password and written write-only:
# it exists in Key Vault and nowhere in Terraform's files.
# (Simplification: app and migrations share the admin login. In prod, migrations run
# as the schema owner and the app as a least-privilege role with DML only.)
resource "azurerm_key_vault_secret" "db_url" {
  name             = local.db_secret_name
  key_vault_id     = azurerm_key_vault.main.id
  content_type     = "postgres-connection-string"
  value_wo         = "postgresql://${local.db_admin_login}:${ephemeral.random_password.db.result}@${azurerm_postgresql_flexible_server.main.fqdn}:5432/${local.db_name}?sslmode=require"
  value_wo_version = var.db_password_version

  # RBAC assignments take effect asynchronously; without this the first apply can 403.
  depends_on = [azurerm_role_assignment.deployer_kv_secrets_officer]
}

# ---- App -----------------------------------------------------------------------
resource "azurerm_container_app" "api" {
  name                         = "ca-${local.base}"
  resource_group_name          = var.resource_group_name
  container_app_environment_id = var.container_app_environment_id
  revision_mode                = "Single" # "Multiple" for blue/green with traffic splitting
  tags                         = var.tags

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.app.id]
  }

  registry {
    server   = var.acr_login_server
    identity = azurerm_user_assigned_identity.app.id # pull with the identity, no registry password
  }

  secret {
    name     = local.db_secret_name
    identity = azurerm_user_assigned_identity.app.id
    # Versionless: a rotated secret is picked up by the next revision/restart.
    key_vault_secret_id = azurerm_key_vault_secret.db_url.versionless_id
  }

  ingress {
    external_enabled = true
    target_port      = 8000

    traffic_weight {
      latest_revision = true
      percentage      = 100
    }
  }

  template {
    min_replicas = var.min_replicas
    max_replicas = 5

    container {
      name   = "api"
      image  = var.image
      cpu    = 0.5
      memory = "1Gi"

      env {
        name        = "DB_URL"
        secret_name = local.db_secret_name
      }
      env {
        name  = "LOG_LEVEL"
        value = "INFO"
      }

      # Same split as the app code: liveness never touches the DB (no restart storms),
      # readiness does (replica leaves the load balancer while the DB is unreachable).
      liveness_probe {
        transport = "HTTP"
        port      = 8000
        path      = "/livez"
      }
      readiness_probe {
        transport = "HTTP"
        port      = 8000
        path      = "/readyz"
      }
    }
  }

  depends_on = [
    azurerm_role_assignment.app_kv_secrets_user,
    azurerm_role_assignment.app_acr_pull,
  ]
}

# ---- Migration job -------------------------------------------------------------
# Same image as the app, so the schema change and the code that needs it ship as one
# versioned artifact. The pipeline starts this job and waits for success BEFORE the
# new app revision takes traffic (expand), exactly like the `migrate` service in
# docker-compose and the migrate step in CI.
resource "azurerm_container_app_job" "migrate" {
  name                         = "caj-${local.base}-migrate"
  resource_group_name          = var.resource_group_name
  location                     = var.location
  container_app_environment_id = var.container_app_environment_id
  tags                         = var.tags

  replica_timeout_in_seconds = 1800 # long enough for a throttled backfill
  # No automatic retries: steps are idempotent so a retry is SAFE, but a failure like
  # "unknown status codes" needs a human to read verify.py first, not a loop.
  replica_retry_limit = 0

  manual_trigger_config {
    parallelism              = 1 # one runner; the advisory lock enforces it anyway
    replica_completion_count = 1
  }

  identity {
    type         = "UserAssigned"
    identity_ids = [azurerm_user_assigned_identity.app.id]
  }

  registry {
    server   = var.acr_login_server
    identity = azurerm_user_assigned_identity.app.id
  }

  secret {
    name                = local.db_secret_name
    identity            = azurerm_user_assigned_identity.app.id
    key_vault_secret_id = azurerm_key_vault_secret.db_url.versionless_id
  }

  template {
    container {
      name    = "migrate"
      image   = var.image
      cpu     = 0.5
      memory  = "1Gi"
      command = ["python", "migrations/migrate.py", "up"]

      env {
        name        = "DB_URL"
        secret_name = local.db_secret_name
      }
    }
  }

  depends_on = [
    azurerm_role_assignment.app_kv_secrets_user,
    azurerm_role_assignment.app_acr_pull,
  ]
}
